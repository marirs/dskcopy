// dskcopy — Disk Utility-inspired sidebar layout
// Palette: Catppuccin Macchiato · accent: dskcopy green (#52c97a)
// Window: 700 × 480 · single-screen layout with drive sidebar.

export struct DriveItem {
    device: string,
    name: string,
    size: string,
    is-system: bool,
    is-selected: bool,
}

export component AppWindow inherits Window {
    title: "dskcopy";
    icon: @image-url("../../../assets/dskcopy-icon.svg");
    width: 700px;
    height: 480px;
    background: #181825;

    // ── Properties ────────────────────────────────────────────────────────────

    // Drives sidebar
    in-out property <[DriveItem]> drives: [];

    // Source
    in-out property <string> source-path: "";
    in-out property <string> source-info: "";
    in-out property <string> detected-type: "";

    // Conditional option visibility
    in-out property <bool> show-macos-option: false;
    in-out property <bool> show-win11-option: false;

    // Activity
    in-out property <string> target-info: "";
    in-out property <int>    progress-value: 0;
    in-out property <string> status-text: "";
    in-out property <string> download-speed: "";
    in-out property <bool>   macos-installer: false;
    in-out property <bool>   bypass-requirements: false;
    in-out property <bool>   is-flashing: false;

    // Overlays
    in-out property <string> error-message: "";
    in-out property <string> confirm-message: "";
    in-out property <bool>   show-confirm: false;
    in-out property <bool>   show-about: false;

    // Derived
    property <bool> has-source: source-info != "" && source-info != "No image selected";
    property <bool> has-target: target-info != "";
    property <bool> activity: is-flashing;
    property <bool> show-progress-block: is-flashing || (progress-value > 0 && progress-value < 100);
    property <bool> can-flash: has-source && has-target && !is-flashing;
    property <bool> has-any-option: show-macos-option || show-win11-option;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback pick-source();
    callback refresh-drives();
    callback select-drive(int);
    callback flash-now();
    callback confirm-flash();
    callback cancel-flash();
    callback drop-file(string);
    callback dismiss-error();
    callback show-about-dialog();
    callback close-about();

    // ── Keyboard shortcuts ────────────────────────────────────────────────────
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if event.text == "r" || event.text == "R" { refresh-drives(); return accept; }
            if event.text == "o" || event.text == "O" { pick-source();    return accept; }
            if event.text == "?" { show-about-dialog(); return accept; }
            reject
        }
    }

    // ── Root layout ───────────────────────────────────────────────────────────
    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ── Toolbar (44px) ───────────────────────────────────────────────────
        Rectangle {
            height: 44px;
            background: #1e1e2e;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 0px;
                alignment: stretch;

                // Logo
                Rectangle {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        Image {
                            source: @image-url("../../../assets/dskcopy-dark.svg");
                            height: 28px;
                            width: 120px;
                            image-fit: contain;
                            image-rendering: smooth;
                            vertical-alignment: center;
                        }
                    }
                }

                // About button
                Rectangle {
                    horizontal-stretch: 0;
                    width: 26px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            border-width: 1px;
                            border-color: #313244;
                            background: abt.has-hover ? #313244 : transparent;
                            animate background { duration: 100ms; }
                            Text { text: "?"; color: #6c7086; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            abt := TouchArea { clicked => { show-about-dialog(); } }
                        }
                    }
                }
            }
        }

        // Toolbar separator
        Rectangle { height: 1px; background: #313244; }

        // ── Error banner ─────────────────────────────────────────────────────
        if error-message != "" : Rectangle {
            min-height: 36px;
            background: rgba(243, 139, 168, 0.08);
            Rectangle { y: parent.height - 1px; height: 1px; background: rgba(243, 139, 168, 0.2); }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;
                alignment: stretch;

                Text {
                    text: "! " + error-message;
                    color: #f38ba8;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                Rectangle {
                    width: 70px;
                    height: 24px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: rgba(243, 139, 168, 0.25);
                    background: dism.has-hover ? rgba(243, 139, 168, 0.15) : transparent;
                    animate background { duration: 100ms; }
                    Text { text: "Dismiss"; color: #f38ba8; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    dism := TouchArea { clicked => { dismiss-error(); } }
                }
            }
        }

        // ── Body: sidebar + content ─────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            background: #181825;

            HorizontalLayout {
                spacing: 0px;
                padding: 0px;

                // ── Left sidebar (190px) ───────────────────────────────────
                Rectangle {
                    width: 190px;
                    background: #1e1e2e;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 12px;
                        padding-bottom: 10px;
                        spacing: 8px;

                        // DRIVES header + refresh
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "DRIVES";
                                color: #6c7086;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                width: 24px;
                                height: 22px;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: #313244;
                                background: rta.has-hover ? #313244 : transparent;
                                animate background { duration: 100ms; }
                                Text { text: "R"; color: #a6adc8; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                rta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { refresh-drives(); }
                                }
                            }
                        }

                        // Drive list
                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;

                            drives-flick := Flickable {
                                x: 0; y: 0;
                                width: parent.width;
                                height: parent.height;
                                viewport-width: parent.width;
                                viewport-height: drives-layout.preferred-height;

                                drives-layout := VerticalLayout {
                                    spacing: 5px;
                                    alignment: start;
                                    width: parent.width;

                                    if drives.length == 0 : Rectangle {
                                        height: 50px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #313244;
                                        background: #181825;
                                        Text {
                                            text: "No drives";
                                            color: #6c7086;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    for drive[idx] in drives : Rectangle {
                                        height: 48px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: drive.is-selected
                                            ? rgba(82, 201, 122, 0.5)
                                            : (drive.is-system ? rgba(243, 139, 168, 0.2) : #313244);
                                        background: drive.is-selected
                                            ? rgba(82, 201, 122, 0.10)
                                            : (row-ta.has-hover ? #252535 : #181825);
                                        animate background { duration: 100ms; }
                                        animate border-color { duration: 100ms; }

                                        // Selected accent bar
                                        if drive.is-selected : Rectangle {
                                            x: 0; y: 4px;
                                            width: 3px;
                                            height: parent.height - 8px;
                                            border-radius: 2px;
                                            background: #52c97a;
                                        }

                                        row-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.select-drive(idx); }
                                        }

                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 8px;
                                            padding-top: 6px;
                                            padding-bottom: 6px;
                                            spacing: 2px;
                                            alignment: center;

                                            Text {
                                                text: drive.name != "" ? drive.name : drive.device;
                                                color: drive.is-system ? #f38ba8 : (drive.is-selected ? #cdd6f4 : #cdd6f4);
                                                font-size: 12px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: drive.size + (drive.is-system ? "  · SYS" : "");
                                                color: drive.is-system ? #f38ba8 : #6c7086;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Vertical separator
                Rectangle { width: 1px; background: #313244; }

                // ── Right content ──────────────────────────────────────────
                Rectangle {
                    horizontal-stretch: 1;
                    background: #181825;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;
                        padding: 0px;

                        // Main content section: SOURCE + OPTIONS
                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;

                            content-col := VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                    // ── SECTION 1: SOURCE ──────────────────────────
                                    VerticalLayout {
                                        vertical-stretch: has-source ? 0 : 1;
                                        spacing: 6px;
                                        Text {
                                            text: "SOURCE";
                                            color: #6c7086;
                                            font-size: 10px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                        }

                                        // Dropzone — entire area clickable
                                        if has-source : Rectangle {
                                            height: 88px;
                                            border-radius: 8px;
                                            border-width: 2px;
                                            border-color: has-source
                                                ? rgba(82, 201, 122, 0.55)
                                                : (dz-hover.has-hover ? rgba(82, 201, 122, 0.45) : #585b70);
                                            background: has-source
                                                ? rgba(82, 201, 122, 0.05)
                                                : (dz-hover.has-hover ? rgba(82, 201, 122, 0.04) : transparent);
                                            animate border-color { duration: 150ms; }
                                            animate background { duration: 150ms; }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                padding: 10px;

                                                Text {
                                                    text: "✓  " + source-info;
                                                    color: #cdd6f4;
                                                    font-size: 12px;
                                                    font-weight: 500;
                                                    horizontal-alignment: center;
                                                    overflow: elide;
                                                }
                                                if detected-type != "" : Text {
                                                    text: detected-type;
                                                    color: #52c97a;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                            dz-hover := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { pick-source(); }
                                            }
                                        }

                                        if !has-source : Rectangle {
                                            vertical-stretch: 1;
                                            min-height: 88px;
                                            border-radius: 8px;
                                            border-width: 2px;
                                            border-color: dz-empty-hover.has-hover ? rgba(82, 201, 122, 0.45) : #585b70;
                                            background: dz-empty-hover.has-hover ? rgba(82, 201, 122, 0.04) : transparent;
                                            animate border-color { duration: 150ms; }
                                            animate background { duration: 150ms; }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                padding: 10px;

                                                Text {
                                                    text: "↑";
                                                    color: dz-empty-hover.has-hover ? #52c97a : #6c7086;
                                                    font-size: 30px;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: "Drag and drop an image here or click";
                                                    color: dz-empty-hover.has-hover ? #cdd6f4 : #a6adc8;
                                                    font-size: 14px;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: ".iso  .img  .dmg  .raw  .gz  .xz  .zip";
                                                    color: #45475a;
                                                    font-size: 10px;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                            dz-empty-hover := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { pick-source(); }
                                            }
                                        }
                                    }

                                    // ── SECTION 2: OPTIONS (only when applicable) ─
                                    if has-any-option : VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "OPTIONS";
                                            color: #6c7086;
                                            font-size: 10px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                        }

                                        // macOS DMG option (conditional)
                                        if show-macos-option : HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 3px;
                                                border-width: 1px;
                                                border-color: macos-installer ? #52c97a : #45475a;
                                                background: macos-installer ? rgba(82, 201, 122, 0.15) : transparent;
                                                if macos-installer : Text { text: "✓"; color: #52c97a; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.macos-installer = !root.macos-installer; }
                                                }
                                            }
                                            Text { text: "Use createinstallmedia (macOS DMG)"; color: #a6adc8; font-size: 12px; vertical-alignment: center; }
                                        }

                                        // Windows 11 bypass (conditional)
                                        if show-win11-option : HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 3px;
                                                border-width: 1px;
                                                border-color: bypass-requirements ? #f9e2af : #45475a;
                                                background: bypass-requirements ? rgba(249, 226, 175, 0.12) : transparent;
                                                if bypass-requirements : Text { text: "✓"; color: #f9e2af; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.bypass-requirements = !root.bypass-requirements; }
                                                }
                                            }
                                            Text {
                                                text: "Remove Windows 11 requirements (TPM/SecureBoot/RAM)";
                                                color: bypass-requirements ? #f9e2af : #a6adc8;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                            }
                        }

                        // Separator between scrollable content and pinned Flash bar
                        Rectangle { height: 1px; background: #313244; }

                        // ── Pinned FLASH section (always visible at bottom) ──
                        Rectangle {
                            height: 84px;
                            background: #181825;

                            VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 6px;

                                // Progress block (only while flashing)
                                if show-progress-block : VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: status-text != "" ? status-text : (is-flashing ? "Flashing…" : "Ready");
                                            color: #cdd6f4;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: progress-value + " %";
                                            color: #6c7086;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: #313244;
                                        Rectangle {
                                            x: 0;
                                            height: 4px;
                                            border-radius: 2px;
                                            width: (parent.width * progress-value) / 100;
                                            background: progress-value >= 100 ? #a6e3a1 : #52c97a;
                                            animate width { duration: 200ms; easing: ease-out; }
                                        }
                                    }
                                }

                                if can-flash || is-flashing : Rectangle {
                                    height: 38px;
                                    border-radius: 7px;
                                    background: is-flashing
                                        ? #252535
                                        : (fta.has-hover ? #3db86a : #52c97a);
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: is-flashing
                                            ? "Flashing…"
                                            : (progress-value == 100 ? "Flash Complete" : "Flash Now");
                                        color: is-flashing ? #6c7086 : #181825;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    fta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if !is-flashing { flash-now(); }
                                        }
                                    }
                                }

                                if !can-flash && !is-flashing : Rectangle {
                                    height: 38px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: #313244;
                                    background: #1e1e2e;
                                    Text {
                                        text: !has-source && !has-target
                                            ? "Select an image and target drive to flash"
                                            : (!has-source ? "Select an image to flash" : "Select a target drive to flash");
                                        color: #6c7086;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Footer (26px) ───────────────────────────────────────────────────
        Rectangle { height: 1px; background: #313244; }

        Rectangle {
            height: 26px;
            background: #1e1e2e;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 0px;

                Text {
                    text: "R Refresh   O Pick file   ? About";
                    color: #45475a;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: is-flashing ? "Writing" : "Ready";
                    color: is-flashing ? #f9e2af : #a6e3a1;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ── Confirmation dialog overlay ───────────────────────────────────────────
    if show-confirm : Rectangle {
        background: rgba(0, 0, 0, 0.65);
        z: 100;

        Rectangle {
            background: #1e1e2e;
            border-width: 1px;
            border-color: #313244;
            border-radius: 10px;
            width: 360px;
            height: 164px;
            x: (parent.width - 360px) / 2;
            y: (parent.height - 164px) / 2;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text { text: "Confirm Flash"; color: #cdd6f4; font-size: 14px; font-weight: 700; }
                Text { text: confirm-message; color: #a6adc8; font-size: 12px; wrap: word-wrap; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #313244;
                        background: canc.has-hover ? #313244 : transparent;
                        Text { text: "Cancel"; color: #a6adc8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        canc := TouchArea { clicked => { cancel-flash(); } }
                    }

                    Rectangle {
                        width: 100px;
                        height: 30px;
                        border-radius: 6px;
                        background: yflsh.has-hover ? #e06060 : #d44040;
                        Text { text: "Yes, Flash"; color: white; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        yflsh := TouchArea { clicked => { confirm-flash(); } }
                    }
                }
            }
        }
    }

    // ── About dialog overlay ──────────────────────────────────────────────────
    if show-about : Rectangle {
        background: rgba(0, 0, 0, 0.65);
        z: 100;

        Rectangle {
            background: #1e1e2e;
            border-width: 1px;
            border-color: #313244;
            border-radius: 10px;
            width: 360px;
            height: 212px;
            x: (parent.width - 360px) / 2;
            y: (parent.height - 212px) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 0px;
                    alignment: start;
                    Image {
                        source: @image-url("../../../assets/dskcopy-dark.svg");
                        height: 24px;
                        width: 100px;
                        image-fit: contain;
                    }
                }

                Text { text: "Version 0.3.0"; color: #6c7086; font-size: 12px; }

                Text {
                    text: "Fast, safe disk image writer";
                    color: #a6adc8;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    text: "github.com/marirs/dskcopy";
                    color: #89b4fa;
                    font-size: 11px;
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    width: 80px;
                    height: 28px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: #313244;
                    background: cls.has-hover ? #313244 : transparent;
                    Text { text: "Close"; color: #a6adc8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    cls := TouchArea { clicked => { close-about(); } }
                }
            }
        }
    }
}
